импорт Система
импорт System::Diagnostics
импорт Система::ВводВывод
импорт Система::Текст
импорт Система::Многопоточность

@Глобально
класс РезультатЗапуска
    @Глобально
    обз пер Успех: Булево
    @Глобально
    обз пер КодВыхода: Число
    @Глобально
    обз пер Вывод: Строка

    конструктор(успех: Булево, кодВыхода: Число, вывод: Строка)
        Успех = успех
        КодВыхода = кодВыхода
        Вывод = вывод
    ;
;

@Глобально
класс Песочница
    пер МаксСимволовВывода: Число = 65536
    пер ТаймаутСекунд: Число = 30
    пер ИмяФайлаПроекта: Строка = "Sandbox.psproj"
    пер ИмяФайлаИсходника: Строка = "Program.pes"

    @ВПроекте
    метод Запустить(исходник: Строка, отмена: CancellationToken): РезультатЗапуска
        пер корень: Строка = Путь.Объединить(Путь.GetTempPath(), "pes-playground")
        Directory.CreateDirectory(корень)

        пер метка: Число = Окружение.СчетчикТиков
        пер имяКаталога: Строка = Преобразование.ВСтроку(метка)
        пер рабочийКаталог: Строка = Путь.Объединить(корень, имяКаталога)
        Directory.CreateDirectory(рабочийКаталог)

        Файл.ЗаписатьВесьТекст(
            Путь.Объединить(рабочийКаталог, ИмяФайлаПроекта),
            Песочница.ПолучитьШаблонПроекта(),
            Кодировка.УТФ8)

        Файл.ЗаписатьВесьТекст(
            Путь.Объединить(рабочийКаталог, ИмяФайлаИсходника),
            исходник,
            Кодировка.УТФ8)

        пер результат = ВыполнитьDotnetRun(рабочийКаталог, отмена)
        Песочница.ПопытатьсяУдалитьКаталог(рабочийКаталог)
        возврат результат
    ;

    статический метод ПолучитьШаблонПроекта(): Строка
        возврат
            "<Project Sdk=\"Pes.NET.Sdk/0.2.5\">" + Окружение.NewLine +
            Окружение.NewLine +
            "  <PropertyGroup>" + Окружение.NewLine +
            "    <OutputType>Exe</OutputType>" + Окружение.NewLine +
            "    <TargetFramework>net10.0</TargetFramework>" + Окружение.NewLine +
            "    <RootNamespace></RootNamespace>" + Окружение.NewLine +
            "  </PropertyGroup>" + Окружение.NewLine +
            Окружение.NewLine +
            "</Project>" + Окружение.NewLine
    ;

    метод ВыполнитьDotnetRun(рабочийКаталог: Строка, отмена: CancellationToken): РезультатЗапуска
        пер процесс: Process = новый Process()
        пер запуск: ProcessStartInfo = новый ProcessStartInfo()
        запуск.FileName = "dotnet"
        запуск.Arguments = "run --project " + ИмяФайлаПроекта
        запуск.WorkingDirectory = рабочийКаталог
        запуск.RedirectStandardOutput = Истина
        запуск.RedirectStandardError = Истина
        запуск.UseShellExecute = Ложь
        запуск.CreateNoWindow = Истина
        запуск.StandardOutputEncoding = Кодировка.УТФ8
        запуск.StandardErrorEncoding = Кодировка.УТФ8
        процесс.StartInfo = запуск

        если не процесс.Start()
            процесс.Dispose()
            возврат новый РезультатЗапуска(Ложь, -1, "Не удалось запустить dotnet.")
        ;

        пер задачаStdout = процесс.StandardOutput.ReadToEndAsync()
        пер задачаStderr = процесс.StandardError.ReadToEndAsync()

        если не процесс.WaitForExit(ТаймаутСекунд * 1000)
            Песочница.ПопытатьсяЗавершить(процесс)
            пер вывод: Строка = ОбрезатьВывод(
                СобратьВыводТекста(задачаStdout.Result, задачаStderr.Result))
            пер таймаутСообщение: Строка =
                "[Превышено время выполнения (" + Преобразование.ВСтроку(ТаймаутСекунд) + " с)]"
            процесс.Dispose()
            возврат новый РезультатЗапуска(
                Ложь,
                -1,
                вывод + "\n\n" + таймаутСообщение)
        ;

        пер кодВыхода: Число = процесс.ExitCode
        пер итог: Строка = ОбрезатьВывод(
            СобратьВыводТекста(задачаStdout.Result, задачаStderr.Result))
        процесс.Dispose()
        возврат новый РезультатЗапуска(
            кодВыхода == 0,
            кодВыхода,
            итог)
    ;

    метод СобратьВыводТекста(стандартныйВывод: Строка, стандартнаяОшибка: Строка): Строка
        пер текстStdout: Строка = стандартныйВывод.TrimEnd()
        пер текстStderr: Строка = стандартнаяОшибка.TrimEnd()

        если String.IsNullOrEmpty(текстStdout)
            возврат текстStderr
        ;

        если String.IsNullOrEmpty(текстStderr)
            возврат текстStdout
        ;

        возврат текстStdout + "\n" + текстStderr
    ;

    метод ОбрезатьВывод(вывод: Строка): Строка
        если вывод.Length <= МаксСимволовВывода
            возврат вывод
        ;

        возврат вывод.Substring(0, МаксСимволовВывода) +
            "\n[... вывод обрезан ...]"
    ;

    статический метод ПопытатьсяЗавершить(процесс: Process): ничто
        попытка
            если не процесс.HasExited
                процесс.Kill(entireProcessTree = Истина)
            ;
        поймать e: Исключение
        ;
    ;

    статический метод ПопытатьсяУдалитьКаталог(путь: Строка): ничто
        попытка
            Directory.Delete(path = путь, recursive = Истина)
        поймать e: Исключение
        ;
    ;
;
